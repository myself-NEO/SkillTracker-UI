{
  "name": "skilltracker-ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "ng serve --host 0.0.0.0 --port 3000 --configuration development",
    "predev": "npm run content",
    "dev:live": "ng serve --host 0.0.0.0 --port 3000 --configuration live",
    "predev:live": "npm run content",
    "build": "ng build --configuration production",
    "prebuild": "npm run validate && npm run content",
    "content": "tsx tools/content/write-manifest.ts && tsx tools/content/build.ts",
    "validate": "tsx tools/content/write-manifest.ts && tsx tools/content/validate.ts",
    "test": "ng test --watch=false && vitest run --config tools/vitest.config.mts",
    "pretest": "tsx tools/content/write-manifest.ts",
    "test:watch": "ng test",
    "test:content": "vitest --config tools/vitest.config.mts",
    "e2e": "playwright test",
    "typecheck": "tsx tools/content/write-manifest.ts && tsc -p tsconfig.app.json --noEmit && tsc -p tools/tsconfig.json --noEmit",
    "clean": "rm -rf dist public/content public/search-index.json content/.generated"
  },
  "dependencies": {
    "@angular/common": "^21.2.18",
    "@angular/compiler": "^21.2.18",
    "@angular/core": "^21.2.18",
    "@angular/forms": "^21.2.18",
    "@angular/platform-browser": "^21.2.18",
    "@angular/router": "^21.2.18",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@lucide/angular": "^1.23.0",
    "@tailwindcss/postcss": "^4.3.2",
    "mermaid": "12.3.0",
    "postcss": "^8.5.19",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "rxjs": "^7.8.2",
    "unified": "^11.0.5",
    "zone.js": "^0.16.2"
  },
  "devDependencies": {
    "@angular/build": "^21.2.19",
    "@angular/cli": "^21.2.18",
    "@angular/compiler-cli": "^21.2.18",
    "@playwright/test": "1.65.1",
    "@tailwindcss/typography": "^0.5.20",
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "@types/node": "^22.14.0",
    "github-slugger": "^2.0.0",
    "jsdom": "^27.4.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "sass": "^1.101.0",
    "shiki": "^4.6.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.9.2",
    "unist-util-visit": "^5.2.0",
    "vitest": "^4.1.12",
    "zod": "^4.6.7"
  }
}
